@article{negi2021mms,
  author  = {Negi, Pawan and Ramachandran, Prabhu},
  title   = {How to train your solver: A method of manufactured solutions for
             weakly compressible smoothed particle hydrodynamics},
  journal = {Physics of Fluids},
  volume  = {33},
  number  = {12},
  pages   = {127108},
  year    = {2021},
  doi     = {10.1063/5.0072383},
  eprint  = {2109.09697},
  archivePrefix = {arXiv},
  note    = {Metadata resolved live 2026-08-18 from Crossref; full text read from the
             arXiv v2 PDF. The verification tier this project does not have. MMS is
             METHOD-AGNOSTIC: its stated requirement is only that an arbitrary source
             term can be added to a particular equation, so it is not SPH-specific.
             Recipe, section IV: write the governing equations AS IMPLEMENTED (keep
             scheme-specific terms such as delta-SPH damping), manufacture a solution,
             take the residual as a source, add it per-particle, sweep particle
             spacing, and fit the order from the L1 error of eq. 26. Five precautions
             on the manufactured solution, notably that it must exercise every term
             and so cannot be time-independent. THREE EMPIRICAL RESULTS THAT WOULD
             OTHERWISE COST A SWEEP EACH: a divergence-free manufactured field fails
             to show second order because the initial divergence error is not
             captured, so use a NON-SOLENOIDAL field; at least 100 timesteps are
             needed before the measured order is trustworthy, and after 100 steps it
             stops depending on the initial particle configuration; and a packed
             rather than perturbed configuration is what tests discretisation
             robustness. Boundary conditions get their own manufactured solution via
             eq. 27, multiplying by (C - F)^m with m = 1 Dirichlet and m = 2 Neumann.
             Source terms are generated symbolically with sympy to avoid hand-coding
             errors. Code at https://gitlab.com/pypr/mms_sph.
             RELEVANT TO THE SOUND-SPEED QUESTION: the authors report that Taylor-Green
             needed c_o = 80 m/s to demonstrate second-order convergence while their
             MMS cases used c_o = 20 m/s, so the achievable order is sound-speed
             dependent in a way a single test can hide.}
}

