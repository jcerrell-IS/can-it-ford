@article{nihei2025fullscale,
  author  = {Nihei, Yasuo and Onomura, Shiho and Bando, Yu and Inoue, Takashi and Kashiwada, Jin and Yoshikawa, Yasuhiro and Tanaka, Mamoru},
  title   = {Full-scale experimental assessment of passenger vehicle stability in flooding flow},
  journal = {Results in Engineering},
  volume  = {28},
  pages   = {107189},
  year    = {2025},
  doi     = {10.1016/j.rineng.2025.107189},
  note    = {CC-BY. Full-scale prototype passenger vehicles in a large outdoor open channel, targeting SLIDING rather than floating. Measures the rolling-resistance coefficient at washaway with the handbrake DISENGAGED: mu_R = 0.0250 and 0.0242, about an order of magnitude below the locked-wheel static value mu_s of approximately 0.30. Critical velocity scales as sqrt(mu), so the unbraked threshold is lower by about (mu_R/mu_s)^(1/2). Also reports C_D = 1.38 +/- 0.18, and that mu_R falls to a steady state near 40 percent of its initial maximum, so evaluating a sliding criterion on the peak mu_R alone is unconservative. CARRIES AN ERRATUM, doi 10.1016/j.rineng.2025.107527: check it before quoting any number from this entry.}
}
