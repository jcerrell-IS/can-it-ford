{
  "permissions": {
    "allow": [
      "Bash(scripts/pane_check.sh*)",
      "Bash(tmux ls*)",
      "Bash(tmux capture-pane*)",
      "Bash(tmux wait-for*)",
      "Bash(tmux display-message*)",
      "Bash(echo*)",
      "Bash(grep*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git fetch*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tmux wait-for -S \"pane_$(tmux display-message -p '#S_#I_#P' 2>/dev/null)_done\" 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
