{
  "permissions": {
    "allow": [
      "Bash(scripts/pane_check.sh*)",
      "Bash(tmux ls*)",
      "Bash(tmux capture-pane*)",
      "Bash(tmux wait-for*)",
      "Bash(tmux display-message*)",
      "Bash(echo*)",
      "Bash(grep*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git fetch*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p ~/.pane_signals && echo \"$(date -u +%s)\" > ~/.pane_signals/$(tmux display-message -p '#S_#I_#P' 2>/dev/null || echo unknown)_done 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/gate_destructive.sh"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/gate_protected_files.sh"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/orient_live.sh"
          }
        ]
      }
    ]
  }
}